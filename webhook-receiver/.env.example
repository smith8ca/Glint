# Port to listen on (default: 3000)
PORT=3000

# Your self-hosted GitLab instance base URL (no trailing slash)
GITLAB_BASE_URL=https://gitlab.example.com

# GitLab personal access token with api scope
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Webhook authentication — set one (or both; signing token takes priority if set)

# Legacy secret token (configured in GitLab webhook settings → Secret token)
WEBHOOK_SECRET=your-webhook-secret

# Signing token for HMAC-SHA256 verification (GitLab 19.0+, follows Standard Webhooks spec)
# Generate in GitLab webhook settings → Signing token. Value starts with "whsec_".
# WEBHOOK_SIGNING_TOKEN=whsec_xxxxxxxxxxxxxxxxxxxx

# Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Claude model to use (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Trust a private or self-signed CA for GitLab (path to a PEM certificate or bundle)
# GITLAB_CA_FILE=/path/to/ca.crt

# Last resort: skip TLS verification for GitLab entirely (default: true).
# Prefer GITLAB_CA_FILE; this exposes GITLAB_TOKEN to interception.
# GITLAB_REJECT_UNAUTHORIZED=false
