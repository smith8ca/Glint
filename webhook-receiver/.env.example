# Port to listen on (default: 3000)
PORT=3000

# Your self-hosted GitLab instance base URL (no trailing slash)
GITLAB_BASE_URL=https://gitlab.example.com

# GitLab personal access token with api scope
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Webhook authentication — set one (or both; signing token takes priority if set)

# Legacy secret token (configured in GitLab webhook settings → Secret token)
WEBHOOK_SECRET=your-webhook-secret

# Signing token for HMAC-SHA256 verification (GitLab 19.0+, follows Standard Webhooks spec)
# Generate in GitLab webhook settings → Signing token. Value starts with "whsec_".
# WEBHOOK_SIGNING_TOKEN=whsec_xxxxxxxxxxxxxxxxxxxx

# AI provider: anthropic (default) or openai-compatible
# AI_PROVIDER=anthropic

# Anthropic API key for Claude (required when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Claude model to use (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI-compatible provider (OpenAI, Ollama, LM Studio, vLLM, OpenRouter, Gemini, ...).
# Used when AI_PROVIDER=openai-compatible. OPENAI_MODEL is then required.
# OPENAI_BASE_URL=https://api.openai.com/v1        # Ollama: http://localhost:11434/v1
# OPENAI_MODEL=gpt-4o-mini                         # Ollama: llama3.2
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx           # leave unset for Ollama

# Most characters of diff sent to the model (default: 20000, minimum: 1000).
# Lower it for local models with a small context window.
# MAX_DIFF_CHARS=20000

# Trust a private or self-signed CA for GitLab (path to a PEM certificate or bundle)
# GITLAB_CA_FILE=/path/to/ca.crt

# Last resort: skip TLS verification for GitLab entirely (default: true).
# Prefer GITLAB_CA_FILE; this exposes GITLAB_TOKEN to interception.
# GITLAB_REJECT_UNAUTHORIZED=false

# Log level: fatal, error, warn, info, debug, trace or silent (default: info).
# Logs are JSON, one object per line on stdout.
# LOG_LEVEL=info
