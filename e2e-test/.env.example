# Anthropic API key — the e2e test calls the real Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Port for the mock GitLab server (default: 4000)
# MOCK_GITLAB_PORT=4000

# Port for the test receiver (default: 3001 — avoids conflicting with a live receiver on 3000)
# RECEIVER_PORT=3001

# How long to wait for the AI note to be posted, in ms (default: 60000)
# NOTE_TIMEOUT_MS=60000
